# ──────────────────────────────────────────────
# HODS Backend Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# Server
PORT=5000

# Firebase Web API Key (from Firebase Console → Project Settings → General → Web API key)
FIREBASE_API_KEY=AIzaSyB4NNmMzN741wQP32H7Sq5daZ3AwCX_PK0

# Firebase Project ID
FIREBASE_PROJECT_ID=hods-2810

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=hods-2810.firebasestorage.app

# JWT Secret — use any long random string (min 32 chars)
JWT_SECRET=hods_super_secret_jwt_key_2024_replace_this

# Path to your service account key JSON (relative to backend folder)
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json
